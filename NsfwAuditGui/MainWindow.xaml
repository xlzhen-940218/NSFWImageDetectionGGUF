<Window x:Class="NsfwAuditGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:NsfwAuditGui.Models"
        mc:Ignorable="d"
        Title="NSFW Image Audit Studio (GGUF ViT-B/16)"
        Height="750" Width="1100"
        MinHeight="750" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Foreground="{StaticResource Brush.TextPrimary}"
        Icon="Assets/AppIcon.ico"
        AllowDrop="True"
        DragOver="OnWindowDragOver"
        Drop="OnWindowDrop">

    <Grid Background="{StaticResource Brush.MicaTint}">
        <Grid Margin="18,14,18,14">
        <Grid.ColumnDefinitions>
            <!-- Left: Sidebar Controls & Settings (Fixed Width 390px) -->
            <ColumnDefinition Width="390" />
            <!-- Right: Dashboard Metrics & Results Canvas (*) -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT COLUMN: CONTROL & SETTINGS SIDEBAR ================= -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,16,0">
            <StackPanel>
                <!-- App Title Header -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10" Background="{StaticResource Brush.Accent}" Margin="0,0,12,0">
                        <TextBlock Text="🛡️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding L10n.AppTitle}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}" />
                        <TextBlock Text="{Binding L10n.AppSubtitle}" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <!-- 1. Action & Live Progress Card -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <!-- Primary Action Buttons -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Command="{Binding StartAuditCommand}"
                                    IsEnabled="{Binding CanScan}"
                                    Padding="14,11">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="▶ " FontSize="13" Foreground="#ffffff" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding L10n.StartAudit}" FontSize="14" FontWeight="SemiBold" Foreground="#ffffff" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Command="{Binding CancelAuditCommand}"
                                    Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Margin="8,0,0,0"
                                    Padding="14,11">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⏹ " FontSize="12" Foreground="#ef4444" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding L10n.StopAudit}" Foreground="#ef4444" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Progress Bar & Status Readout -->
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" MaxWidth="280" />
                                <TextBlock Text="{Binding ProgressPercentText}" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent}" />
                            </Grid>
                            <ProgressBar Value="{Binding ProgressPercent}"
                                         Maximum="100"
                                         IsIndeterminate="{Binding IsIndeterminate}"
                                         Height="6" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 2. Folder Settings Card -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <!-- Target Directory -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{Binding L10n.TargetFolderTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding TargetDirectory, UpdateSourceTrigger=PropertyChanged}" FontSize="12" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Click="OnBrowseTargetFolderClicked" Style="{StaticResource ModernButtonStyle}" Margin="6,0,0,0" Padding="9,6" ToolTip="{Binding L10n.Browse}">
                                    <TextBlock Text="📁" FontSize="12" />
                                </Button>
                                <Button Grid.Column="2" Command="{Binding OpenTargetFolderCommand}" Style="{StaticResource ModernButtonStyle}" Margin="6,0,0,0" Padding="9,6" ToolTip="{Binding L10n.OpenFolder}">
                                    <TextBlock Text="↗" FontSize="12" />
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- NSFW Quarantine Directory -->
                        <StackPanel>
                            <TextBlock Text="{Binding L10n.NsfwFolderTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NsfwDirectory, UpdateSourceTrigger=PropertyChanged}" FontSize="12" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Click="OnBrowseNsfwFolderClicked" Style="{StaticResource ModernButtonStyle}" Margin="6,0,0,0" Padding="9,6" ToolTip="{Binding L10n.Browse}">
                                    <TextBlock Text="📁" FontSize="12" />
                                </Button>
                                <Button Grid.Column="2" Command="{Binding OpenNsfwFolderCommand}" Style="{StaticResource ModernButtonStyle}" Margin="6,0,0,0" Padding="9,6" ToolTip="{Binding L10n.OpenFolder}">
                                    <TextBlock Text="↗" FontSize="12" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 3. Inference Parameters Card -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <!-- Threshold Slider -->
                        <StackPanel Margin="0,0,0,12">
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="{Binding L10n.ThresholdTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextSecondary}" />
                                <TextBlock Text="{Binding ThresholdPercentText}" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Brush.Accent}" />
                            </Grid>
                            <Slider Minimum="0.50" Maximum="0.99" SmallChange="0.01" LargeChange="0.05" Value="{Binding Threshold}" />
                        </StackPanel>

                        <!-- Device & Batch Size -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="{Binding L10n.DeviceTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AvailableDevices}" SelectedItem="{Binding SelectedDevice}" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="{Binding L10n.BatchSizeTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AvailableBatchSizes}" SelectedItem="{Binding SelectedBatchSize}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>

                        <!-- Toggles -->
                        <StackPanel>
                            <CheckBox Content="{Binding L10n.RecursiveTitle}" IsChecked="{Binding IsRecursive}" Margin="0,0,0,8" />
                            <CheckBox Content="{Binding L10n.DryRunTitle}" IsChecked="{Binding IsDryRun}" ToolTip="{Binding L10n.DryRunTooltip}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 4. Advanced Model Paths Expander -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <Expander Header="{Binding L10n.AdvancedHeader}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Brush.TextSecondary}">
                        <StackPanel Margin="0,8,0,0">
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="{Binding L10n.EnginePathLabel}" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding ExePath, UpdateSourceTrigger=PropertyChanged}" FontSize="11" />
                                    <Button Grid.Column="1" Content="..." Click="OnBrowseExeClicked" Style="{StaticResource ModernButtonStyle}" Margin="6,0,0,0" Padding="8,4" />
                                </Grid>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="{Binding L10n.ModelPathLabel}" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding ModelPath, UpdateSourceTrigger=PropertyChanged}" FontSize="11" />
                                    <Button Grid.Column="1" Content="..." Click="OnBrowseModelClicked" Style="{StaticResource ModernButtonStyle}" Margin="6,0,0,0" Padding="8,4" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </Border>

                <!-- 5. Bottom Language Selector -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🌐 " FontSize="13" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding L10n.LanguageLabel}" FontSize="12" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center" />
                        </StackPanel>
                        <ComboBox HorizontalAlignment="Right"
                                  SelectedValue="{Binding SelectedLanguage}"
                                  SelectedValuePath="Tag"
                                  Width="130">
                            <ComboBoxItem Tag="auto" Content="{Binding L10n.LangAuto}" />
                            <ComboBoxItem Tag="zh" Content="{Binding L10n.LangZh}" />
                            <ComboBoxItem Tag="en" Content="{Binding L10n.LangEn}" />
                        </ComboBox>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= RIGHT COLUMN: DASHBOARD & RESULTS WORKSPACE ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Top InfoBar Alert Banner & Metric Cards -->
                <RowDefinition Height="*" />    <!-- Main Work Area: Tabs for Results & Logs -->
            </Grid.RowDefinitions>

            <!-- Row 0: Top InfoBar & Metric Cards Bar -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <!-- Notification Banner -->
                <Border Background="#1e293b" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,10"
                        Visibility="{Binding InfoBarIsOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="ℹ️ " FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding InfoBarTitle}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding InfoBarMessage}" FontSize="12" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1" Click="OnCloseInfoBarClicked" Style="{StaticResource ModernButtonStyle}" Padding="6,2" Content="✕" FontSize="11" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- 4 Sleek Metric Badges -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Total Scanned -->
                    <Border Grid.Column="0" Style="{StaticResource SubtleCardStyle}" Margin="0,0,8,0">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{Binding L10n.MetricTotal}" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" />
                                <TextBlock Text="{Binding TotalImages}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Brush.TextPrimary}" Margin="0,4,0,0" />
                            </StackPanel>
                            <TextBlock Text="🖼" FontSize="18" Foreground="{StaticResource Brush.TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                        </Grid>
                    </Border>

                    <!-- Safe Images -->
                    <Border Grid.Column="1" Style="{StaticResource SubtleCardStyle}" Margin="4,0,4,0">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{Binding L10n.MetricSafe}" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" />
                                <TextBlock Text="{Binding SafeCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Brush.Safe}" Margin="0,4,0,0" />
                            </StackPanel>
                            <TextBlock Text="✓" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Brush.Safe}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                        </Grid>
                    </Border>

                    <!-- NSFW Detected -->
                    <Border Grid.Column="2" Style="{StaticResource SubtleCardStyle}" Margin="4,0,4,0">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{Binding L10n.MetricNsfw}" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" />
                                <TextBlock Text="{Binding NsfwCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Brush.Nsfw}" Margin="0,4,0,0" />
                            </StackPanel>
                            <TextBlock Text="⚠️" FontSize="18" Foreground="{StaticResource Brush.Nsfw}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                        </Grid>
                    </Border>

                    <!-- Moved Quarantine -->
                    <Border Grid.Column="3" Style="{StaticResource SubtleCardStyle}" Margin="8,0,0,0">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{Binding L10n.MetricMoved}" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" />
                                <TextBlock Text="{Binding MovedCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Brush.Moved}" Margin="0,4,0,0" />
                            </StackPanel>
                            <TextBlock Text="📦" FontSize="18" Foreground="{StaticResource Brush.Moved}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Row 1: Tabbed Workspace: Audit Results & Real-time Logs -->
            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                <!-- Tab 1: Audit Results -->
                <TabItem Header="{Binding L10n.TabResults}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Filter Toolbar -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding L10n.FilterAll}" Command="{Binding SetFilterCommand}" CommandParameter="All" Style="{StaticResource ModernButtonStyle}" Margin="0,0,6,0" Padding="14,6" />
                                <Button Content="{Binding L10n.FilterNsfw}" Command="{Binding SetFilterCommand}" CommandParameter="NSFW" Style="{StaticResource ModernButtonStyle}" Foreground="{StaticResource Brush.Nsfw}" FontWeight="Bold" Margin="0,0,6,0" Padding="14,6" />
                                <Button Content="{Binding L10n.FilterSafe}" Command="{Binding SetFilterCommand}" CommandParameter="Safe" Style="{StaticResource ModernButtonStyle}" Foreground="{StaticResource Brush.Safe}" FontWeight="Bold" Margin="0,0,6,0" Padding="14,6" />
                                <Button Command="{Binding ClearResultsCommand}" IsEnabled="{Binding CanScan}" ToolTip="{Binding L10n.ClearResults}" Style="{StaticResource ModernButtonStyle}" Padding="10,6">
                                    <TextBlock Text="🗑" FontSize="12" />
                                </Button>
                            </StackPanel>

                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Brush.TextSecondary}">
                                <Run Text="{Binding L10n.ShowingItems, Mode=OneWay}" />
                                <Run Text=" " />
                                <Run Text="{Binding FilteredItems.Count, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource Brush.TextPrimary}" />
                                <Run Text=" " />
                                <Run Text="{Binding L10n.ItemsSuffix, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>

                        <!-- Virtualizing ListView for Fast Rendering of Image Cards -->
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding FilteredItems}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,6" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:AuditItem}">
                                    <Border Background="{StaticResource Brush.CardBg}"
                                            BorderBrush="{StaticResource Brush.Border}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Thumbnail (Compact 90x65 with smooth dark background) -->
                                            <Border Grid.Column="0" Width="90" Height="65" CornerRadius="6" Background="#0b1120" ClipToBounds="True">
                                                <Grid>
                                                    <TextBlock Text="🖼" FontSize="20" Foreground="{StaticResource Brush.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>

                                            <!-- File Information -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,10,0">
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" />
                                                <TextBlock Text="{Binding FilePath}" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}" Margin="0,2,0,4" />
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="#334155" CornerRadius="4" Padding="6,1" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding Extension}" FontSize="10" Foreground="#cbd5e1" FontWeight="SemiBold" />
                                                    </Border>
                                                    <TextBlock Text="{Binding FileSizeText}" FontSize="11" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    <TextBlock Text="{Binding ActionText}" FontSize="11" Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}" FontWeight="Medium" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Status Badge Pill & Probability -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0">
                                                <Border Background="{Binding Status, Converter={StaticResource StatusToBackgroundBrushConverter}}"
                                                        BorderBrush="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="10,4"
                                                        HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding StatusBadgeText}"
                                                               FontWeight="Bold"
                                                               FontSize="11"
                                                               Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}" />
                                                </Border>
                                                <TextBlock Text="{Binding ScorePercentText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,4,0,0" />
                                            </StackPanel>

                                            <!-- Quick Action Buttons -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Click="OnOpenFileClicked" Tag="{Binding FilePath}" ToolTip="{Binding DataContext.L10n.OpenFile, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource ModernButtonStyle}" Margin="0,0,6,0" Padding="9,6">
                                                    <TextBlock Text="🔍" FontSize="12" />
                                                </Button>
                                                <Button Click="OnShowInExplorerClicked" Tag="{Binding FilePath}" ToolTip="{Binding DataContext.L10n.LocateFile, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource ModernButtonStyle}" Padding="9,6">
                                                    <TextBlock Text="📂" FontSize="12" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>

                <!-- Tab 2: Console Engine Logs -->
                <TabItem Header="{Binding L10n.TabLogs}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Action bar for logs -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Real-time output stream from nsfw_audit.exe process" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button Click="OnCopyLogsClicked" Style="{StaticResource ModernButtonStyle}" Margin="0,0,6,0" Padding="12,5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📋 " FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding L10n.CopyLogs}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ClearLogsCommand}" Style="{StaticResource ModernButtonStyle}" Padding="12,5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🗑 " FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding L10n.ClearLogs}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Log text stream viewer -->
                        <Border Grid.Row="1" Background="#090d16" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding EngineLogs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11" Foreground="#94a3b8" TextWrapping="NoWrap" Margin="0,1" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
    </Grid>
</Window>
